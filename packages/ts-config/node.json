{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node App",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2022",
    "lib": ["es2022"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noImplicitAny": false
  }
}
