{
  "name": "sports-social-monorepo",
  "private": true,
  "version": "1.0.0",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "dev": "turbo dev",
    "build": "npx prisma generate --schema=./packages/database/prisma/schema.prisma && npx turbo run build --filter=@sports-social/api",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:seed": "turbo run db:seed"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "turbo": "^2.10.12",
    "typescript": "^5.4.5"
  }
}